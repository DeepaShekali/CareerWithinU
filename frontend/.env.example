# CareerWithinU Frontend Environment Variables
# Copy to .env.local for custom local testing or configure in Vercel project settings:
#
# Vercel Configuration:
# Key: VITE_API_URL
# Value: https://<your-render-backend-url>.onrender.com (e.g. https://careerwithinu-api.onrender.com)
VITE_API_URL=http://localhost:8000
